# CivicPilot Environment Variables Specification
# Copy this file to .env.local and configure your environment.
# DO NOT commit real secrets or credentials to source control.

# ==============================================================================
# ENVIRONMENT MODES SUMMARY:
# - DEMO MODE: DEMO_MODE=true. Uses non-durable in-memory storage, simulated
#   notifications (status='simulated'), and deterministic heuristics fallback.
#   Ideal for local UI preview without database or cloud dependencies.
# - TEST MODE: DEMO_MODE=true or dedicated test Supabase instance.
# - PRODUCTION MODE: DEMO_MODE=false. Requires NEXT_PUBLIC_SUPABASE_URL,
#   SUPABASE_SECRET_KEY, ADMIN_API_KEY, REVIEWER_SECRET_KEY, and
#   N8N_WEBHOOK_SECRET (if n8n mode is used). Fails closed if missing.
# ==============================================================================

# ==============================================================================
# 1. CORE OPERATIONAL MODE & DURABILITY
# ==============================================================================
# DEMO_MODE:
# - 'true':  Non-durable in-memory storage. State resets on server restart.
# - 'false': PRODUCTION DURABLE MODE. All reads, writes, audit logs, reviews,
#            and analytics are strictly routed to Supabase PostgreSQL.
#            Throws a clear 500 error if Supabase credentials are missing or database fails.
DEMO_MODE=true

# Public application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Intake Processing Mode ('in_app' or 'n8n')
# - 'in_app': Uses built-in Next.js / TypeScript AI orchestrator (default).
# - 'n8n':    Routes through external n8n workflow engine. Fails fast if webhook is unreachable.
INTAKE_PROCESSING_MODE=in_app

# ==============================================================================
# 2. ADMINISTRATIVE, CRON & REVIEWER AUTHORIZATION (SECURITY BOUNDARIES)
# ==============================================================================
# Master admin key required to authorize database resets at POST /api/seed in production (DEMO_MODE=false).
# Must be passed via 'x-admin-key' header.
ADMIN_API_KEY=

# Human review officer secret required to authorize POST /api/review.
# Reviewers must supply this key via 'x-reviewer-secret' header.
REVIEWER_SECRET_KEY=

# Internal secret for scheduled cron watchdog jobs (POST /api/escalate).
# Pass via 'x-cron-secret' header or Bearer token.
CRON_SECRET=

# Internal shared secret for webhook callbacks (e.g. n8n -> POST /api/internal/intake-persist).
# Both N8N_WEBHOOK_SECRET and WEBHOOK_SHARED_SECRET are supported as aliases.
N8N_WEBHOOK_SECRET=
WEBHOOK_SHARED_SECRET=
FEEDBACK_SECRET_KEY=

# ==============================================================================
# 3. SUPABASE POSTGRESQL (REQUIRED WHEN DEMO_MODE=false)
# ==============================================================================
# WARNING: NEVER expose SUPABASE_SECRET_KEY to the client or add NEXT_PUBLIC_ prefix!
# All privileged mutations and RLS-protected queries execute server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy keys remain supported for existing Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 4. GOOGLE GEMINI AI (OPTIONAL IN DEMO_MODE, RECOMMENDED FOR PRODUCTION)
# ==============================================================================
# Optional in DEMO_MODE (falls back to deterministic civic safety heuristics).
# Required for live generative extraction and reasoning when INTAKE_PROCESSING_MODE=direct.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ==============================================================================
# 5. n8n AUTOMATION WORKFLOWS (REQUIRED IF INTAKE_PROCESSING_MODE=n8n)
# ==============================================================================
N8N_WEBHOOK_INTAKE_URL=
N8N_WEBHOOK_REVIEW_URL=
N8N_WEBHOOK_SLA_URL=
N8N_WEBHOOK_NOTIFY_URL=
N8N_WEBHOOK_FEEDBACK_URL=
# For n8n's WhatsApp workflow (n8n process environment)
CIVICPILOT_APP_URL=http://localhost:3000
WHATSAPP_PHONE_NUMBER_ID=
# For private Meta photo downloads by the Next.js service
WHATSAPP_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0

# Government connector. Keep mock mode until an agency approves the integration.
GOVERNMENT_ADAPTER=mock
GOVERNMENT_INTEGRATION_ENABLED=false
PILOT_ESCALATION_EMAIL=
OPEN311_BASE_URL=
OPEN311_JURISDICTION_ID=
OPEN311_API_KEY=
OPEN311_SERVICE_CODES={}

# ==============================================================================
# 6. EXTERNAL NOTIFICATION PROVIDERS (OPTIONAL)
# ==============================================================================
# In demo mode or when unconfigured, notifications are recorded as status='simulated' with delivered_at=null.
# When real credentials are provided, notifications dispatch live via provider.

# Telegram Officer Escalation Alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_OFFICER_CHAT_ID=

# SMTP Email Dispatch
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@example.com
